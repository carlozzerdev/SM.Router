{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Routing": {
    "FallbackCategoryId": "general",
    "FallbackCategoryName": "Consulta general",
    "MinConfidence": 0.6,
    "MaxClarificationTurns": 3,
    "MaxPromptLength": 4000,
    "AiTimeout": "00:00:30",
    "DefaultFollowUpQuestion": "¿Podrías darme más detalles sobre lo que necesitas?"
  },
  "Categories": {
    "FilePath": "Data/categories_tree.json"
  },
  "Ai": {
    "Provider": "OpenAI",
    "SystemPromptPath": "Prompts/routing-system.md"
  },

  "OpenAI": {
    "ApiKey": "",
    "Model": "gpt-5.6-luna",
    "BaseUrl": "https://api.openai.com/v1/",
    "Organization": null,
    "Project": null,
    "Timeout": "00:01:40",
    "MaxFunctionCallIterations": 5,
    "Defaults": {
      "ReasoningEffort": "low",
      "ReasoningSummary": null,
      "Verbosity": null,
      "MaxOutputTokens": 2048,
      "Temperature": null,
      "TopP": null,
      "Store": false,
      "ServiceTier": null,
      "Truncation": null
    }
  }
}
